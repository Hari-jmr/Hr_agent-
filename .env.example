# Root environment file - copy to .env before running docker compose
# cp .env.example .env

# === Authentication ===
SECRET_KEY=change-me-to-a-long-random-string
APP_NAME=JMR HR Portal API
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8001
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === Database (Odoo 8.0 - used for employee login) ===
DB_HOST=your-odoo-host
DB_PORT=5432
DB_NAME=your-odoo-database
DB_USER=your-odoo-user
DB_PASSWORD=your-odoo-password

# === RAG Database (pgvector) ===
# Inside docker-compose this is overridden to postgres:5432 automatically.
# For local (non-Docker) backend runs, use the exposed host port:
DATABASE_URL=postgresql://admin:secure_password@localhost:5433/hr_agent

# === OpenRouter ===
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# === RAG Settings ===
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.3

# === App ===
DEBUG=false
WORKERS=4
PORT=8001
