# === Authentication ===
SECRET_KEY=your-strong-random-secret-key
APP_NAME=JMR HR Portal API
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8001
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8001,http://localhost:8001

# === Database (Odoo 8.0 - used for login auth) ===
DB_HOST=your-odoo-host
DB_PORT=5432
DB_NAME=your-odoo-database
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# === RAG Database ===
DATABASE_URL=postgresql://admin:secure_password@localhost:5433/hr_agent

# === OpenRouter ===
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_LLM_MODEL=anthropic/claude-3-5-sonnet
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# === RAG Settings ===
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.7

# === App ===
DEBUG=true
WORKERS=4
PORT=8001
CORS_ORIGINS=http://localhost:3000,http://localhost:8001
